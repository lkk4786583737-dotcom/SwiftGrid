# OpenAI-compatible model configuration. Never commit real keys.
SWIFTGRID_API_KEY=
SWIFTGRID_BASE_URL=https://api.deepseek.com
SWIFTGRID_MODEL=deepseek-v4-pro

# Local desktop use: true. Public/shared deployment: false.
SWIFTGRID_ALLOW_RUNTIME_CONFIG=true

# Used by Docker/cloud platforms. Local default is 8000.
PORT=8000
